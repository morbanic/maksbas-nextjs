# Copy to .env and fill in. Never commit the filled-in file.

# Postgres connection string used by your Drizzle handle.
DATABASE_URL=postgres://user:password@localhost:5432/mydb

# Ships inside the mobile app. Only allows device registration.
# node -e "console.log('pk_live_' + require('crypto').randomBytes(24).toString('base64url'))"
MAKSBAS_PUBLIC_KEY=pk_live_replace_me

# Server-side only, never in a bundle. Allows sending, listing devices,
# managing segments. Must differ from the public key.
# node -e "console.log('sk_live_' + require('crypto').randomBytes(24).toString('base64url'))"
MAKSBAS_SECRET_KEY=sk_live_replace_me

# Protects /cron/drain. Vercel Cron sends it as `Authorization: Bearer`.
# Optional — omit and the drain endpoint stays unauthenticated.
CRON_SECRET=replace_me

# The whole service account file from Firebase Console -> Project Settings ->
# Service accounts -> Generate new private key, on one line.
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}

# Absolute origin of this deployment, used for self-chaining drain batches.
# On Vercel this is inferred from VERCEL_URL — set it only elsewhere.
# MAKSBAS_BASE_URL=https://example.com
